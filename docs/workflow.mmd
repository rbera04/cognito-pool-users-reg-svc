%% Mermaid flowchart for Cognito User Management Service workflow

flowchart TD
  Start([User/Admin Client]) -->|1. POST /login| Login["🔑 POST /login<br/>Authenticate User"]
  Login -->|initiate_auth| Cognito1["AWS Cognito<br/>USER_PASSWORD_AUTH"]
  Cognito1 -->|AuthenticationResult| SetCookie["Set id_token<br/>HTTP-only Cookie"]
  SetCookie -->|Tokens + Cookie| UserAuth["✅ User Authenticated<br/>(IdToken, AccessToken,<br/>RefreshToken)"]

  UserAuth -->|2. GET /whoami| WhoAmI["📋 GET /whoami<br/>Verify & Decode Token"]
  WhoAmI -->|Verify Token| TokenCheck{Token Valid?}
  TokenCheck -->|Yes| Claims["✅ Return Token Claims<br/>(email, role, custom attrs)"]
  TokenCheck -->|No| Error401["❌ 401 Unauthorized"]

  UserAuth -->|3. POST /create-user| CreateUser["👤 POST /create-user<br/>(Admin Only)"]
  CreateUser -->|Check Token| AdminCheck1{Is Admin?}
  AdminCheck1 -->|No| Error403["❌ 403 Forbidden"]
  AdminCheck1 -->|Yes| ValidateRole{Role in<br/>ALLOWED_ROLES?}
  ValidateRole -->|No| Error400_Role["❌ 400 Invalid Role"]
  ValidateRole -->|Yes| CreateCognito["admin_create_user<br/>with custom attributes"]
  CreateCognito -->|admin_set_user_password| AdminSetPass["Set Permanent Password"]
  AdminSetPass -->|admin_update_user_attributes| UpdateAttrs["Apply Custom Attributes<br/>(custom:roleName,<br/>custom:roleId)"]
  UpdateAttrs -->|Success| SuccessCreate["✅ User Created"]

  UserAuth -->|4. GET /list-users| ListUsers["📊 GET /list-users<br/>(Admin Only)"]
  ListUsers -->|Check Token| AdminCheck2{Is Admin?}
  AdminCheck2 -->|No| Error403_2["❌ 403 Forbidden"]
  AdminCheck2 -->|Yes| PaginateUsers["Cognito: list_users<br/>with pagination"]
  PaginateUsers -->|Extract attributes| FormatUsers["📋 Format User List<br/>with attributes"]
  FormatUsers -->|Success| SuccessList["✅ Return Users List"]

  UserAuth -->|5. POST /update-user| UpdateUser["✏️ POST /update-user<br/>(Admin Only)"]
  UpdateUser -->|Check Token| AdminCheck3{Is Admin?}
  AdminCheck3 -->|No| Error403_3["❌ 403 Forbidden"]
  AdminCheck3 -->|Yes| ValidateAttrs{Attributes<br/>to Update?}
  ValidateAttrs -->|None| Error400_NoAttrs["❌ 400 No Attributes"]
  ValidateAttrs -->|Yes| AdminUpdateAttrs["admin_update_user_attributes<br/>Update custom fields"]
  AdminUpdateAttrs -->|Fetch updated| FetchUpdated["admin_get_user<br/>Get updated attributes"]
  FetchUpdated -->|Success| SuccessUpdate["✅ User Updated"]

  UserAuth -->|6. POST /change-password| ChangePass["🔐 POST /change-password<br/>Change Own Password"]
  ChangePass -->|Extract username| ReAuth["Re-authenticate<br/>with old password"]
  ReAuth -->|initiate_auth| Cognito2["AWS Cognito<br/>USER_PASSWORD_AUTH"]
  Cognito2 -->|Get AccessToken| CheckAccess{AccessToken<br/>Obtained?}
  CheckAccess -->|No| Error401_OldPass["❌ 401 Old Password<br/>Incorrect"]
  CheckAccess -->|Yes| ChangePass_API["change_password<br/>with AccessToken"]
  ChangePass_API -->|Success| SuccessPass["✅ Password Changed"]
  ChangePass_API -->|Invalid New Pass| Error400_NewPass["❌ 400 Password<br/>Requirements Not Met"]

  Error401 --> End1(["End - Error"])
  Error400_Role --> End2(["End - Error"])
  Error403 --> End3(["End - Error"])
  Error403_2 --> End4(["End - Error"])
  Error403_3 --> End5(["End - Error"])
  Error400_NoAttrs --> End6(["End - Error"])
  Error401_OldPass --> End7(["End - Error"])
  Error400_NewPass --> End8(["End - Error"])
  
  Claims --> End9(["✅ End - Success"])
  SuccessCreate --> End10(["✅ End - Success"])
  SuccessList --> End11(["✅ End - Success"])
  SuccessUpdate --> End12(["✅ End - Success"])
  SuccessPass --> End13(["✅ End - Success"])

